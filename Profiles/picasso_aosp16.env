CONFIG_ENV=Profiles/picasso_aosp16.env

DEVICE_NAME=Redmi K30 5G
DEVICE_CODENAME=picasso

EXTRA_CMDS:LD=ld.lld LLVM=1

# NonLa 内核源码（TG 作者给的那份，2.1 就是 staging）
KERNEL_SOURCE=https://github.com/august-aosp/android_kernel_xiaomi_picasso.git
KERNEL_BRANCH=staging-2
# 该内核原版是用 clang 20 编的；先按模板默认的 19.1.7 试，报错再换 20
CLANG_SOURCE=https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.7/LLVM-19.1.7-Linux-X64.tar.xz
CLANG_BRANCH=

GCC_GNU=false
GCC_64_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9
GCC_64_BRANCH=android12L-release
GCC_32_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9
GCC_32_BRANCH=android12L-release

DEFCONFIG_SOURCE=
# 仓库自带 stock_defconfig（166KB，就是我之前从你原厂 boot 里抠出来的同一份配置）
DEFCONFIG_NAME=stock_defconfig
DEFCONFIG_ORIGIN_DEFCONFIG=

# 用 RKSU（rsuntk 的非 GKI 分支）；版本选 v3.0.0-30-legacy = 你手机上现在这个驱动 32334
KERNELSU_SOURCE=https://github.com/rsuntk/KernelSU.git
KERNELSU_BRANCH=v3.0.0-30-legacy
KERNELSU_NAME=KernelSU

# 关键：打开 SUSFS（内核级隐藏，农行/中国移动 需要的）
SUSFS_ENABLE=true
SUSFS_FIXED=false

AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

# 不打包 boot（我们自己用 magiskboot 把 Image 换进原厂 boot）
BOOT_SOURCE=

LXC_ENABLE=false
HAVE_NO_DTBO=false
HAVE_NO_DTBO_TOOL=false
ROM_TEXT=pixelos_android16
